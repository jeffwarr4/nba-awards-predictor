# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual env
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS / tools
.DS_Store
Thumbs.db

# Secrets
.env
*.key
*.pem

# Data (keep raw/processed out of git by default)
data/raw/*
# The MVP vote seed is tracked (src/data/fetch_mvp_votes.py); the Basketball-Reference
# page cache (data/raw/bbref_cache/, ~190 MB) is not.
!data/raw/voting/

# Ignore everything in processed by default
data/processed/*

# But allow the folder itself
!data/processed/current
!data/processed/outputs

# Training data: normalized votes, vote-getter dataset, every player-season (src/data/build_history.py)
!data/processed/voting/
!data/processed/training/

# Allow seed snapshots (one-time committed files)
!data/processed/seeds/
!data/processed/seeds/**

# And allow the candidates file(s)
!data/processed/current/nba_mvp_current_candidates.csv
!data/processed/current/nba_team_standings.csv
!data/processed/outputs/web_prior_top10.csv


# Outputs (optional: keep generated artifacts out of git)
outputs/canva/
outputs/web/

# Logs
*.log
